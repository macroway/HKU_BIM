# CheckBIM Agent — 环境变量

# --- Loop3 推荐：火山方舟 Doubao Responses API ---
CHECKBIM_OFFLINE=0
LLM_PROVIDER=ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428

# --- 离线 / CI：无 Key 时用规则路由 ---
# CHECKBIM_OFFLINE=1
# LLM_PROVIDER=offline

# --- 备选：OpenAI 兼容接口 ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
